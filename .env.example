# Copy to .env and fill in from Supabase → Project Settings → API.
#
# EXPO_PUBLIC_ prefixed vars are inlined into the JS bundle at build time,
# which is correct for these two: the anon key is designed to be public and is
# safe to ship *provided row level security is on* (see supabase/schema.sql).
#
# Never put the service_role key in here. It bypasses RLS entirely and would
# give anyone who unpacked the app full read/write on every student's data.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
